{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yog-guide.local/schema/black_stone.schema.json",
  "title": "Black stone (黑石), Chinese",
  "description": "One element of black_stones.json → items. `text` from page 黑石, `text_template` from 模板:推荐黑石.",
  "type": "object",
  "allOf": [{"$ref": "common.schema.json#/$defs/provenance"}],
  "required": ["id", "name", "effects", "template_source_url", "template_revid"],
  "unevaluatedProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^black_stone-[0-9]{2}$"},
    "name": {"type": "string", "minLength": 1},
    "effects": {
      "type": ["array", "null"],
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pieces", "text", "text_template", "same_in_template"],
        "properties": {
          "pieces": {"enum": [2, 4, 8]},
          "text": {"$ref": "common.schema.json#/$defs/str"},
          "text_template": {"$ref": "common.schema.json#/$defs/str"},
          "same_in_template": {"type": "boolean"}
        }
      }
    },
    "template_source_url": {"type": "string", "pattern": "^https://wiki\\.biligame\\.com/bookofyog/"},
    "template_revid": {"type": "integer", "minimum": 1}
  }
}
