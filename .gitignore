# Unpacked game files: read-only reference, never commit
data/raw/GameDB/
data/raw/game_db/

# Python caches
__pycache__/
*.pyc

# step 3 work files: they quote game texts that are not used in data/en
# (also holds the update baseline of `python -m yog update`)
translate/work/

# site build output and generated files (game images, embedded data)
web/node_modules/
web/dist/
web/src/generated/
# game images: generated by web/scripts/prepare-images.ts, never committed
web/public/img/
# screenshots of the site show game art
docs/screenshots/

# local logs of the scraper
data/raw/*.log
