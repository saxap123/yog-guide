 "blood_ranks": {
  "ranks": [
   {
    "rank": 1,
    "text": "When [Fiery Brambles] hits an enemy, the caster gains Hunt State. In Arena, there is instead a chance to gain Hunt State, and the chance increases with the Perception difference between the caster and the target. Hunt State lasts for 7.5 seconds. While in Hunt State, the caster can freely consume all remaining Energy to unleash Fiery Brambles again."
   },
   {
    "rank": 2,
    "text": "Flame Streak trigger chance +10%."
   },
   {
    "rank": 3,
    "text": "Flame Streak has a chance to steal up to 20 Force from targets hit by normal attacks. (Higher Perception increases chance.)"
   },
   {
    "rank": 4,
    "text": "Force stolen by [Flame Streak] is used to restore the Force of all Blackguards in the team. When Elizabeth kills an enemy, the duration of Hunt State is extended by 1.5 seconds; hitting a Boss or an enemy Blackguard extends it by 1 second and 0.5 seconds respectively. Through these effects, Hunt State can be extended up to a maximum of 15 seconds."
   },
   {
    "rank": 5,
    "text": "At battle start, all Black Guards in the team gain +10% Counter Skill trigger rate for 30s."
   },
   {
    "rank": 6,
    "text": "+10% All DMG Dealt by Elizabeth."
   }
