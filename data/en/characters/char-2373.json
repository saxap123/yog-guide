    "rank": 3,
    "text": "DMG dealt by [Silent Finisher] is also treated as Normal Attack DMG and can trigger [Windborne Snow] effects; additionally, the number of attacks of [Silent Finisher] +2."
   },
   {
    "rank": 4,
    "text": "[Immortal Bones] damage lock duration +1.5 sec."
   },
