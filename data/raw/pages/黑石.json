  "wikitext": "*[[黑石强化|黑石攻略入口]]\n<div class=\"sy-box-1\" style=\"margin-top: 10px\"> \n<div class=\"sy-box-1-n\"> \n<div class=\"sy-title-1\">黑石</div> \n<div class=\"sy-divider\"></div> \n<div class=\"sy-content\">\n<div class=\"main-line-wrap\" style=\"width:100%;\"> \n<div class=\"resp-tabs\" style=\"border-spacing: 0px; border-color: #D0CCC8\"> \n<ul class=\"resp-tabs-list clearfix\" style=\"margin-left:0;margin-top: 14px;background: #ECE5D8;\"> \n<li class=\"active bili-list-style\"><span class=\"tab-panel\">恐熊</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">巫妖</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">怒兽</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">猎蛛</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">蝮蛇</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">诡眼</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">幽鬼</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">雷影狼</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">石像鬼</span></li>\n</ul> \n<div class=\"resp-tabs-container\"> \n<!--1-->\n<div class=\"resp-tab-content\" style=\"display:block;\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">攻击力提升2%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">普攻造成伤害提升10%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">攻击速度提升25%</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">法术精通+2</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">法术强度提升5%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">怒气上限+150</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">物理精通+2</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">攻击速度提升10%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">物理强度提升5%</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">精神精通+2</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">受到暴击伤害减少25%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">最大生命值提升15%</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">冲锋类技能冷却时间缩短10%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">前锋职业黑卫攻击速度提升15%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">冲锋类技能释放后自身攻击速度提升60%，持续4秒</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">暴击倍率提升25%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">狩魔职业黑卫物理强度提升12%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">击杀敌方目标后，伤害提升20%，持续5秒</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">最大生命值提升5%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">闪避提升12%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">复活几率提升15%</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">刺杀职业黑卫普通攻击暴击几率提升10%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">技能回避率提升10%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">刺杀职业黑卫拥有【闪电之剑：攻击向敌方射出一支闪电箭，对其造成造成408+(50%-60%)*物理&法术强度的闪电伤害，随后这支闪电箭会继续攻击它周围最近的敌人。闪电箭每跳跃一次，伤害就减少30%，最多可攻击6个自标。】</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">最大生命值提升5%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">守护职业黑卫获得援护技能，一场战斗起效1次</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">触发护体时，回复30%生命上限的血量</span>\n</div>\n</div>\n</div>\n<!--1-->\n</div> \n</div> \n<div class=\"resp-tabs\" style=\"border-spacing: 0px; border-color: #D0CCC8\"> \n<ul class=\"resp-tabs-list clearfix\" style=\"margin-left:0;margin-top: 14px;background: #ECE5D8;\"> \n<li class=\"active bili-list-style\"><span class=\"tab-panel\">雪甲虫</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">感电狐</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">霜蹄</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">冰凤</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">诅咒灵</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">闪鸣鸟</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">金乌</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">迅角兽</span></li>\n<li class=\"bili-list-style\"><span class=\"tab-panel\">炎龙</span></li>\n\n</ul> \n<div class=\"resp-tabs-container\"> \n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">每2秒恢复10%上限护盾</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">法术伤害提升10%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">开启冰霜护盾并获得3个冰霜之球，抵御3次伤害，并对其伤害来源施加冰缓效果，持续4秒，冷却30秒</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">每5秒回复生命上限1%的生命值</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">技能回避率提升10%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">受到伤害时，有15%几率对附近8米范围内的最多3个单位释放叉型闪电，对目标造成【77+2%*自身法术强度】的闪电伤害并添加一层感电，冷却1秒</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">冰霜伤害提升5%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">对冰缓状态的目标造成的冰霜伤害提升20%，对冰冻目标造成的冰霜伤害提升50%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">普通攻击有3%几率造成冰缓</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">冰霜穿透+15</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">冰霜伤害+10%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">携带者普通攻击命中冰缓单位时，有20%几率触发冰暴效果。冰冻目标以及附近3米范围的内敌人持续1秒，造成100%法术&物理强度伤害(CD:1秒)</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">物理伤害增幅+5%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">物理伤害对虚弱状态的敌人造成伤害增加10%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">物理伤害暴击时有3%几率时目标处于虚弱状态，持续4秒</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">闪电伤害增幅+5%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">闪电属性的黑卫恢复护盾时的恢复量提高25%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">自身存在护盾时，造成的闪电伤害增加10%</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">造成的治疗效果+7%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">治疗时如果目标处于低血状态，则回复量额外提升25%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">治疗目标同时恢复目标等同治疗值10%的护盾</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">初始怒气/能量+50</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">怒气/能量恢复+5/秒</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">当存在护盾时，每释放一次必杀技都会使下一次必杀技造成的伤害提高5%，最高不会超过20%，护盾为0时增伤效果清零</span>\n</div>\n</div>\n</div>\n<!--1-->\n<div class=\"resp-tab-content\">\n<div class=\"BOX-N py-1\">\n<div style=\"width:100%;overflow:hidden\">\n<span class=\"box-hs-num\">(2套装)</span><span class=\"box-hs-text\">火焰伤害增幅+5%</span>\n<span class=\"box-hs-num\">(4套装)</span><span class=\"box-hs-text\">火焰属性的黑卫受到的治疗效果+15%</span>\n<span class=\"box-hs-num\">(8套装)</span><span class=\"box-hs-text\">造成的火焰伤害提升5%，当自身生命值小于50%时，该效果提升至10%</span>\n</div>\n</div>\n</div>\n{{#css:\n.box-hs-num {\n    float:left;\n    width:76px;\n    height:22px;\n    line-height:22px;\n    background-color:#614783;\n    font-weight: bold;\n    border-radius: 2px;\n    color: #fff;\n    text-align: center;\n    margin:5px 0px;\n    margin-right:6px;\n    font-size:12px\n}\n.box-hs-text {\n    float:left;\n    width:calc(100% - 82px);\n    line-height:22px;\n    margin:5px 0px;\n}\n}}",
